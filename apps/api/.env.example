# Ariad API — copy to .env for local overrides. Every value here is the default.

# Port the HTTP server binds to.
PORT=5191

# Interface to bind.
HOST=0.0.0.0

# development | test | production
NODE_ENV=development

# SQLite file. Relative paths resolve against the api workspace root.
DATABASE_PATH=./data/ariad.sqlite

# Where the app is reached in a browser. Links in emails (unsubscribe, tracking,
# confirmation) are built from this until a Public URL is saved under
# Settings > Organization, which then wins.
APP_URL=http://localhost:5190

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190

# 64 hex characters. Encrypts stored SMTP passwords and signs tracking links.
# Leave unset and a key is generated once into ./data/secret.key (keep that file:
# without it the stored passwords cannot be read).
# ARIAD_SECRET=

# Set to 0 to run the API without the background sender (queue, automations).
WORKER=1

# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info
