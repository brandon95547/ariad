    "nodemailer": "^10.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.10",
    "pino-pretty": "^13.1.2",
